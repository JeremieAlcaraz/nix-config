{
  "title": "Double ! → | (pour AZERTY pipe)",
  "rules": [
    {
      "description": "Double !! → |, single ! → !",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": ["shift"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "double_exclam_pipe_count",
                "value": 1
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "1",
              "modifiers": ["shift"]
            },
            {
              "set_variable": {
                "name": "double_exclam_pipe_count",
                "value": 0
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "double_exclam_pipe_count",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": ["shift"]
            }
          },
          "to": [
            {
              "key_code": "backslash",
              "modifiers": ["shift"]
            },
            {
              "set_variable": {
                "name": "double_exclam_pipe_count",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "double_exclam_pipe_count",
              "value": 1
            }
          ]
        }
      ]
    }
  ]
}
