# Twenty env — deployed via poppy-apply (SOPS secrets)
# Template variables replaced by scripts/poppy/apply-from-magnolia.sh

TAG=v1.18.1

# PostgreSQL
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD={{PG_DATABASE_PASSWORD}}
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

# Redis
REDIS_URL=redis://redis:6379

# Server
SERVER_URL={{SERVER_URL}}

# Storage S3 (Garage)
STORAGE_TYPE=S3
STORAGE_S3_REGION=garage
STORAGE_S3_NAME=twenty
STORAGE_S3_ENDPOINT=http://host.containers.internal:3900
STORAGE_S3_ACCESS_KEY_ID={{STORAGE_ACCESS_KEY_ID}}
STORAGE_S3_SECRET_ACCESS_KEY={{STORAGE_SECRET_ACCESS_KEY}}

# App secret
APP_SECRET={{APP_SECRET}}

# Migrations
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false

# Google OAuth
MESSAGING_PROVIDER_GMAIL_ENABLED=true
CALENDAR_PROVIDER_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID={{GOOGLE_CLIENT_ID}}
AUTH_GOOGLE_CLIENT_SECRET={{GOOGLE_CLIENT_SECRET}}
AUTH_GOOGLE_CALLBACK_URL={{SERVER_URL}}/auth/google/redirect
AUTH_GOOGLE_APIS_CALLBACK_URL={{SERVER_URL}}/auth/google-apis/get-access-token