# Moodboard — variables applicatives
# Les secrets sont injectés depuis secrets/poppy.yaml (SOPS)
# Les valeurs sensibles sont remplacées par les valeurs décryptées au déploiement

# Garage S3 (bucket credentials)
GARAGE_BUCKET={{GARAGE_BUCKET}}
GARAGE_ACCESS_KEY_ID={{GARAGE_ACCESS_KEY_ID}}
GARAGE_SECRET_ACCESS_KEY={{GARAGE_SECRET_ACCESS_KEY}}

# App
PORT=3005
GARAGE_S3_ENDPOINT=http://host.containers.internal:3900
AWS_DEFAULT_REGION=garage

# AI (optionnel)
GEMINI_API_KEY={{GEMINI_API_KEY}}