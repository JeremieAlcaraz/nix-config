# Vikunja — variables applicatives
# Les secrets sont injectés depuis secrets/poppy.yaml (SOPS)
# Les valeurs sensibles sont remplacées par les valeurs décryptées au déploiement

VIKUNJA_JWT_SECRET={{VIKUNJA_JWT_SECRET}}
VIKUNJA_PUBLIC_URL={{VIKUNJA_PUBLIC_URL}}
VIKUNJA_SERVICE_TIMEZONE=Europe/Paris
VIKUNJA_SERVICE_ENABLECALDAV=true
VIKUNJA_SERVICE_ENABLEREGISTRATION=true
VIKUNJA_SERVICE_ENABLETASKATTACHMENTS=true
VIKUNJA_DATABASE_TYPE=sqlite
VIKUNJA_DATABASE_PATH=/app/vikunja/files/vikunja.db
VIKUNJA_FILES_BASEPATH=/app/vikunja/files
VIKUNJA_FILES_MAXSIZE=20MB
VIKUNJA_LOG_ENABLED=true
VIKUNJA_LOG_LEVEL=INFO