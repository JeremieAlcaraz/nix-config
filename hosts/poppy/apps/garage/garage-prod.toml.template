metadata_dir = "/data/meta"
data_dir = "/data/data"
db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "0.0.0.0:3901"
rpc_secret = "{{RPC_SECRET}}"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"
# URL publique pour les presigned URLs (resolue par le navigateur via Tailscale Serve :9000)
s3_endpoint = "https://poppy.inanga-sirius.ts.net:9000"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[k2v_api]
api_bind_addr = "[::]:3904"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "{{ADMIN_TOKEN}}"
metrics_token = "{{METRICS_TOKEN}}"
